# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Database URL (SQLite by default)
DATABASE_URL=sqlite:///./cloud.db

# Telegram Channel/Group ID where files will be uploaded (should start with -100)
# Make sure the bot is an admin in this channel.
CHANNEL_ID=-1001234567890

# Secure key for JWT and encryption (32 chars recommended)
ENCRYPTION_KEY=my-super-secret-encryption-key-32-chars

# The public URL of your frontend (where the bot button should point)
WEBAPP_URL=https://your-app-domain.vercel.app
